// Campus — School & College Management System
// Data model (see SRS section 9). One schema, PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums

enum Role {
  SUPER_ADMIN
  ADMIN
  HOD
  TEACHER
  STUDENT
  PARENT
  ACCOUNTANT
  OFFICE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  ON_DUTY
}

enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  DROPPED
  COMPLETED
  DETAINED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum SubjectType {
  THEORY
  PRACTICAL
  ELECTIVE
  CO_CURRICULAR
}

enum MarkStatus {
  PRESENT
  ABSENT
  EXEMPTED
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  MARKS_ENTRY
  LOCKED
  PUBLISHED
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  LATE
  EVALUATED
  RETURNED
}

enum PaymentMode {
  CASH
  CHEQUE
  DD
  BANK_TRANSFER
  UPI
  CARD
  NETBANKING
}

enum SubstitutionStatus {
  NEEDS_COVER
  ASSIGNED
  CANCELLED
  COMBINED
  CONDUCTED
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

// ---------------------------------------------------------------- core / setup

model Institute {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("SCHOOL") // SCHOOL | JUNIOR_COLLEGE | DEGREE_COLLEGE
  board     String?
  code      String?
  address   String?
  phone     String?
  email     String?
  logoUrl   String?
  // configurable business rules (SRS: NFR-M-03)
  minAttendancePct        Int     @default(75)
  attendanceEditWindowHrs Int     @default(24)
  leaveCountsAsPresent    Boolean @default(false)
  allowLateSubmission     Boolean @default(true)
  blockDefaulterHallTicket Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AcademicYear {
  id        String   @id @default(cuid())
  name      String   @unique // 2026-27
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)

  sections     Section[]
  enrollments  Enrollment[]
  allocations  TeacherAllocation[]
  exams        Exam[]
  feeStructures FeeStructure[]
  holidays     Holiday[]
  monthlyFeedback MonthlyClassFeedback[]
  createdAt    DateTime @default(now())
}

model Department {
  id      String  @id @default(cuid())
  name    String
  code    String  @unique
  hodId   String?
  hod     Staff?  @relation("DeptHod", fields: [hodId], references: [id])

  classes  ClassLevel[]
  subjects Subject[]
  staff    Staff[]
}

model ClassLevel {
  id           String  @id @default(cuid())
  name         String // "Class 10", "FY BSc Sem 1"
  displayOrder Int     @default(0)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  minAttendancePct Int?

  sections      Section[]
  classSubjects ClassSubject[]
  feeStructures FeeStructure[]

  @@unique([name])
}

model Section {
  id             String @id @default(cuid())
  name           String // A, B
  capacity       Int    @default(60)
  room           String?
  classLevelId   String
  classLevel     ClassLevel @relation(fields: [classLevelId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  classTeacherId String?
  classTeacher   Staff? @relation("ClassTeacher", fields: [classTeacherId], references: [id])

  enrollments  Enrollment[]
  allocations  TeacherAllocation[]
  slots        TimetableSlot[]
  assignments  Assignment[]
  examSchedules ExamSchedule[]
  monthlyFeedback MonthlyClassFeedback[]

  @@unique([classLevelId, name, academicYearId])
}

model Subject {
  id           String      @id @default(cuid())
  code         String      @unique
  name         String
  type         SubjectType @default(THEORY)
  credits      Int         @default(0)
  maxMarks     Int         @default(100)
  passMarks    Int         @default(35)
  attendanceApplicable Boolean @default(true)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  classSubjects ClassSubject[]
  allocations   TeacherAllocation[]
  slots         TimetableSlot[]
  assignments   Assignment[]
  periodAttendance PeriodAttendance[]
  marks         Mark[]
  examSchedules ExamSchedule[]
}

model ClassSubject {
  id            String  @id @default(cuid())
  classLevelId  String
  classLevel    ClassLevel @relation(fields: [classLevelId], references: [id])
  subjectId     String
  subject       Subject @relation(fields: [subjectId], references: [id])
  isElective    Boolean @default(false)
  periodsPerWeek Int    @default(5)

  @@unique([classLevelId, subjectId])
}

model Holiday {
  id             String   @id @default(cuid())
  date           DateTime
  title          String
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([date, academicYearId])
}

// ---------------------------------------------------------------- people

model User {
  id           String  @id @default(cuid())
  loginId      String  @unique // email / enrolment no / employee code
  email        String?
  phone        String?
  passwordHash String
  role         Role
  isActive     Boolean @default(true)
  mustChangePassword Boolean @default(true)
  lastLoginAt  DateTime?
  failedAttempts Int @default(0)
  lockedUntil  DateTime?

  student   Student?
  staff     Staff?
  guardian  Guardian?
  auditLogs AuditLog[]
  createdAt DateTime @default(now())
}

model Student {
  id             String  @id @default(cuid())
  admissionNo    String  @unique
  firstName      String
  lastName       String
  dob            DateTime?
  gender         String?
  bloodGroup     String?
  category       String?
  phone          String?
  email          String?
  address        String?
  photoUrl       String?
  admissionDate  DateTime @default(now())
  exitDate       DateTime?
  exitReason     String?
  isActive       Boolean @default(true)
  userId         String? @unique
  user           User?   @relation(fields: [userId], references: [id])

  enrollments  Enrollment[]
  guardians    Guardian[]
  dailyAtt     DailyAttendance[]
  periodAtt    PeriodAttendance[]
  submissions  AssignmentSubmission[]
  marks        Mark[]
  results      Result[]
  fees         StudentFee[]
  leaves       StudentLeave[]
  complaints   StudentComplaint[]
  monthlyFeedback MonthlyClassFeedback[]
  createdAt    DateTime @default(now())
}

model Guardian {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id])
  relation  String  @default("FATHER")
  name      String
  phone     String?
  email     String?
  occupation String?
  isPrimary Boolean @default(false)
  userId    String? @unique
  user      User?   @relation(fields: [userId], references: [id])
}

model Enrollment {
  id             String @id @default(cuid())
  studentId      String
  student        Student @relation(fields: [studentId], references: [id])
  sectionId      String
  section        Section @relation(fields: [sectionId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  rollNo         Int?
  status         EnrollmentStatus @default(ACTIVE)
  joinedOn       DateTime @default(now())
  leftOn         DateTime?

  @@unique([studentId, academicYearId])
}

model Staff {
  id           String  @id @default(cuid())
  employeeCode String  @unique
  firstName    String
  lastName     String
  designation  String?
  qualification String?
  phone        String?
  email        String?
  photoUrl     String?
  joiningDate  DateTime @default(now())
  maxPeriodsPerDay Int @default(6)
  maxPeriodsPerWeek Int @default(30)
  isTeaching   Boolean @default(true)
  isActive     Boolean @default(true)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  userId       String? @unique
  user         User?   @relation(fields: [userId], references: [id])

  hodOf         Department[] @relation("DeptHod")
  classTeacherOf Section[]   @relation("ClassTeacher")
  allocations   TeacherAllocation[]
  slots         TimetableSlot[]
  leaves        LeaveApplication[]
  absentSubs    Substitution[] @relation("AbsentTeacher")
  coverSubs     Substitution[] @relation("SubstituteTeacher")
  assignments   Assignment[]
  leaveBalances LeaveBalance[]
  complaintsAgainst StudentComplaint[]
  createdAt     DateTime @default(now())
}

// ---------------------------------------------------------------- allocation & timetable

model TeacherAllocation {
  id             String @id @default(cuid())
  staffId        String
  staff          Staff @relation(fields: [staffId], references: [id])
  subjectId      String
  subject        Subject @relation(fields: [subjectId], references: [id])
  sectionId      String
  section        Section @relation(fields: [sectionId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  isCoTeacher    Boolean @default(false)

  @@unique([subjectId, sectionId, academicYearId, staffId])
}

model TimetableSlot {
  id         String @id @default(cuid())
  sectionId  String
  section    Section @relation(fields: [sectionId], references: [id])
  subjectId  String
  subject    Subject @relation(fields: [subjectId], references: [id])
  staffId    String
  staff      Staff @relation(fields: [staffId], references: [id])
  weekday    Int    // 1 = Monday ... 6 = Saturday
  periodNo   Int
  startTime  String // "09:00"
  endTime    String // "09:45"
  room       String?

  periodAttendance PeriodAttendance[]
  substitutions    Substitution[]

  @@unique([sectionId, weekday, periodNo])
}

// ---------------------------------------------------------------- attendance

model DailyAttendance {
  id         String @id @default(cuid())
  studentId  String
  student    Student @relation(fields: [studentId], references: [id])
  date       DateTime @db.Date
  status     AttendanceStatus
  remark     String?
  markedById String?
  markedAt   DateTime @default(now())

  @@unique([studentId, date])
  @@index([date])
}

model PeriodAttendance {
  id         String @id @default(cuid())
  studentId  String
  student    Student @relation(fields: [studentId], references: [id])
  slotId     String
  slot       TimetableSlot @relation(fields: [slotId], references: [id])
  subjectId  String
  subject    Subject @relation(fields: [subjectId], references: [id])
  date       DateTime @db.Date
  status     AttendanceStatus
  markedById String?
  bySubstitute Boolean @default(false)
  markedAt   DateTime @default(now())

  @@unique([studentId, slotId, date])
  @@index([date])
  @@index([subjectId])
}

model AttendanceCorrection {
  id          String @id @default(cuid())
  kind        String // DAILY | PERIOD
  recordId    String
  oldValue    String
  newValue    String
  reason      String
  status      ApprovalStatus @default(PENDING)
  requestedById String
  approvedById  String?
  createdAt   DateTime @default(now())
  decidedAt   DateTime?
}

model StudentLeave {
  id         String @id @default(cuid())
  studentId  String
  student    Student @relation(fields: [studentId], references: [id])
  fromDate   DateTime @db.Date
  toDate     DateTime @db.Date
  reason     String
  status     ApprovalStatus @default(PENDING)
  decidedById String?
  remark     String?
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------- staff leave & substitution

model LeaveType {
  id            String @id @default(cuid())
  name          String @unique // Casual, Sick, Earned, Duty, LOP
  annualQuota   Int    @default(12)
  isPaid        Boolean @default(true)

  applications LeaveApplication[]
  balances     LeaveBalance[]
}

model LeaveBalance {
  id          String @id @default(cuid())
  staffId     String
  staff       Staff @relation(fields: [staffId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int
  opening     Float @default(0)
  availed     Float @default(0)

  @@unique([staffId, leaveTypeId, year])
}

model LeaveApplication {
  id          String @id @default(cuid())
  staffId     String
  staff       Staff @relation(fields: [staffId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  fromDate    DateTime @db.Date
  toDate      DateTime @db.Date
  isHalfDay   Boolean @default(false)
  reason      String
  status      ApprovalStatus @default(PENDING)
  decidedById String?
  decisionRemark String?
  createdAt   DateTime @default(now())
  decidedAt   DateTime?

  substitutions Substitution[]
}

model Substitution {
  id            String @id @default(cuid())
  date          DateTime @db.Date
  slotId        String
  slot          TimetableSlot @relation(fields: [slotId], references: [id])
  absentStaffId String
  absentStaff   Staff @relation("AbsentTeacher", fields: [absentStaffId], references: [id])
  substituteStaffId String?
  substituteStaff   Staff? @relation("SubstituteTeacher", fields: [substituteStaffId], references: [id])
  leaveApplicationId String?
  leaveApplication   LeaveApplication? @relation(fields: [leaveApplicationId], references: [id])
  status        SubstitutionStatus @default(NEEDS_COVER)
  note          String?
  createdAt     DateTime @default(now())

  @@unique([slotId, date])
  @@index([date])
}

// ---------------------------------------------------------------- assignments

model Assignment {
  id          String @id @default(cuid())
  title       String
  description String?
  subjectId   String
  subject     Subject @relation(fields: [subjectId], references: [id])
  sectionId   String
  section     Section @relation(fields: [sectionId], references: [id])
  staffId     String
  staff       Staff @relation(fields: [staffId], references: [id])
  assignedOn  DateTime @default(now())
  dueDate     DateTime
  maxMarks    Int     @default(10)
  attachmentUrl String?
  isPublished Boolean @default(true)

  submissions AssignmentSubmission[]
  createdAt   DateTime @default(now())
}

model AssignmentSubmission {
  id           String @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  studentId    String
  student      Student @relation(fields: [studentId], references: [id])
  status       SubmissionStatus @default(PENDING)
  submittedAt  DateTime?
  isLate       Boolean @default(false)
  content      String?
  fileUrl      String?
  marks        Float?
  remark       String?
  evaluatedById String?
  evaluatedAt  DateTime?

  @@unique([assignmentId, studentId])
}

// ---------------------------------------------------------------- exams

model Exam {
  id             String @id @default(cuid())
  name           String
  type           String @default("UNIT_TEST")
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  weightagePct   Int    @default(100)
  status         ExamStatus @default(DRAFT)
  publishAt      DateTime?
  createdAt      DateTime @default(now())

  schedules ExamSchedule[]
  marks     Mark[]
  results   Result[]
}

model ExamSchedule {
  id        String @id @default(cuid())
  examId    String
  exam      Exam @relation(fields: [examId], references: [id])
  sectionId String
  section   Section @relation(fields: [sectionId], references: [id])
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])
  date      DateTime @db.Date
  startTime String @default("10:00")
  durationMin Int  @default(120)
  maxMarks  Int    @default(100)
  room      String?

  @@unique([examId, sectionId, subjectId])
}

model Mark {
  id         String @id @default(cuid())
  examId     String
  exam       Exam @relation(fields: [examId], references: [id])
  studentId  String
  student    Student @relation(fields: [studentId], references: [id])
  subjectId  String
  subject    Subject @relation(fields: [subjectId], references: [id])
  marksObtained Float?
  maxMarks   Int    @default(100)
  status     MarkStatus @default(PRESENT)
  isLocked   Boolean @default(false)
  enteredById String?
  verifiedById String?
  updatedAt  DateTime @updatedAt

  @@unique([examId, studentId, subjectId])
}

model Result {
  id         String @id @default(cuid())
  examId     String
  exam       Exam @relation(fields: [examId], references: [id])
  studentId  String
  student    Student @relation(fields: [studentId], references: [id])
  total      Float
  maxTotal   Float
  percentage Float
  grade      String
  rank       Int?
  isPass     Boolean
  remark     String?
  publishedAt DateTime?

  @@unique([examId, studentId])
}

model GradeBand {
  id      String @id @default(cuid())
  grade   String
  minPct  Float
  maxPct  Float
  point   Float @default(0)
}

// ---------------------------------------------------------------- fees

model FeeHead {
  id       String @id @default(cuid())
  name     String @unique
  isFine   Boolean @default(false)
  items    FeeStructureItem[]
}

model FeeStructure {
  id             String @id @default(cuid())
  name           String
  classLevelId   String?
  classLevel     ClassLevel? @relation(fields: [classLevelId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  items          FeeStructureItem[]
  studentFees    StudentFee[]
}

model FeeStructureItem {
  id             String @id @default(cuid())
  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id])
  feeHeadId      String
  feeHead        FeeHead @relation(fields: [feeHeadId], references: [id])
  amount         Float

  @@unique([feeStructureId, feeHeadId])
}

model StudentFee {
  id             String @id @default(cuid())
  studentId      String
  student        Student @relation(fields: [studentId], references: [id])
  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id])
  totalAmount    Float
  concession     Float @default(0)
  concessionNote String?
  netPayable     Float
  createdAt      DateTime @default(now())

  installments FeeInstallment[]
  payments     FeePayment[]

  @@unique([studentId, feeStructureId])
}

model FeeInstallment {
  id           String @id @default(cuid())
  studentFeeId String
  studentFee   StudentFee @relation(fields: [studentFeeId], references: [id])
  seq          Int
  amount       Float
  dueDate      DateTime @db.Date
  paidAmount   Float @default(0)

  @@unique([studentFeeId, seq])
}

model FeePayment {
  id           String @id @default(cuid())
  studentFeeId String
  studentFee   StudentFee @relation(fields: [studentFeeId], references: [id])
  receiptNo    String @unique
  amount       Float
  mode         PaymentMode @default(CASH)
  reference    String?
  paidAt       DateTime @default(now())
  collectedById String?
  isCancelled  Boolean @default(false)
  cancelReason String?
}

// ---------------------------------------------------------------- comms & audit

model StudentComplaint {
  id              String          @id @default(cuid())
  studentId       String
  student         Student         @relation(fields: [studentId], references: [id])
  teacherId       String
  teacher         Staff           @relation(fields: [teacherId], references: [id])
  subject         String
  description     String
  status          ComplaintStatus @default(OPEN)
  response        String?
  respondedById   String?
  respondedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([teacherId])
}

model MonthlyClassFeedback {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id])
  sectionId      String
  section        Section  @relation(fields: [sectionId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  month          DateTime @db.Date
  rating         Int
  comments       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([studentId, academicYearId, month])
  @@index([sectionId, month])
}

model Notice {
  id         String @id @default(cuid())
  title      String
  body       String
  audience   String @default("ALL") // ALL | STAFF | STUDENTS | PARENTS | SECTION:<id>
  createdById String?
  validFrom  DateTime @default(now())
  validTo    DateTime?
  createdAt  DateTime @default(now())
}

model AuditLog {
  id        String @id @default(cuid())
  userId    String?
  user      User?  @relation(fields: [userId], references: [id])
  actorName String?
  role      String?
  module    String
  action    String
  entity    String?
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([module])
}
